{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://api.shopradar.uk/*",
    "https://*.lemonsqueezy.com/*",
    "https://shopradar.uk/*",
    "https://www.shopradar.uk/*",
    "http://localhost/*",
    "http://localhost:3000/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open ShopRadar store insights panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopradar.uk/*",
        "https://www.shopradar.uk/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "extension-config.js",
        "local-dev-config.js",
        "extension-guard.js",
        "website-device-sync.js"
      ],
      "run_at": "document_start"
    }
  ]
}

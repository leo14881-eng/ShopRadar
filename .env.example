# ShopRadar 生产环境变量（模板）
# 用法：复制为 shopradar-server/.env 并填入真实值，再通过 SFTP 上传到 Vultr
# 注意：SFTP 默认只上传 shopradar-server/ 目录，.env 请放在该目录内

PORT=3000
NODE_ENV=production

# Lemon Webhook Signing secret（6–40 字符，与 Lemon 后台完全一致）
LEMON_SQUEEZY_WEBHOOK_SECRET=your_live_webhook_secret
SHOPRADAR_LEMON_WEBHOOK_VERIFY=1

# Lemon API（后台管理/后续功能用，暂未接入可保留占位）
LEMON_SQUEEZY_API_TOKEN=your_live_api_token

# 访问令牌签名密钥（建议 ≥32 位随机字符；与 SHOPRADAR_TOKEN_SECRET 二选一即可）
JWT_SECRET=your_production_jwt_secret
SHOPRADAR_TOKEN_SECRET=your_production_jwt_secret

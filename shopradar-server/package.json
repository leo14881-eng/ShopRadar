{
  "name": "shopradar-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShopRadar 免费次数鉴权服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tunnel": "scripts\\tunnel.cmd",
    "tunnel:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tunnel.ps1",
    "ngrok": "scripts\\ngrok.cmd",
    "ngrok:setup": "scripts\\ngrok-setup.cmd",
    "reset-pro": "node scripts/reset-pro.js",
    "reset-quota": "node scripts/reset-quota.js",
    "grant-pro": "node scripts/grant-pro.js",
    "grant-pro-by-email": "node scripts/grant-pro-by-email.js",
    "seed-trending": "node scripts/seed-trending.js",
    "clean:test-data": "node scripts/clean-test-data.js",
    "test": "node scripts/test-full-flow.js",
    "test:flow": "node scripts/test-full-flow.js",
    "test:v1": "node scripts/test-v1-api.js",
    "test:spawn": "node scripts/test-full-flow.js --spawn",
    "setup-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-secrets.ps1",
    "rotate-lemon-secret": "node scripts/rotate-lemon-webhook-secret.js",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "redis": "^4.7.1",
    "sqlite3": "^5.1.7"
  }
}

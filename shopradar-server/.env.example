# 生产环境 — 复制为 .env 并填入真实密钥（勿提交 git）

PORT=3000
NODE_ENV=production

# 【必填】Lemon Webhook Signing secret（6–40 字符，与 Lemon 后台一致）
LEMON_SQUEEZY_WEBHOOK_SECRET=your_live_webhook_secret
SHOPRADAR_LEMON_WEBHOOK_VERIFY=1

# 【必填】Redis 飙升榜缓存（未连接则服务无法启动）
REDIS_URL=redis://127.0.0.1:6379

# 飙升榜缓存 TTL（秒，默认 600 = 10 分钟）
# TRENDING_CACHE_TTL_SEC=600

# 法律页重定向目标（api.shopradar.uk/privacy → 官网）
SHOPRADAR_WEBSITE_URL=https://shopradar.uk

# 【必填】访问令牌 HMAC 密钥
JWT_SECRET=your_production_jwt_secret
SHOPRADAR_TOKEN_SECRET=your_production_jwt_secret
